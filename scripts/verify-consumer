#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
candidate="$(git -C "$ROOT" rev-parse HEAD^{commit})"
artifacts="${CORE_RELEASE_ARTIFACTS:-$ROOT/.local/release}"
export CORE_RELEASE_ARTIFACTS="$artifacts"
consumer="$artifacts/consumer"
if [[ "${1:-}" == --public ]]; then
  [[ -f "$artifacts/public-identity.json" ]] || { echo 'Public payload gate has not passed' >&2; exit 1; }
  consumer="$artifacts/public-consumer"
  composer --working-dir="$consumer" install --no-interaction --no-progress --prefer-dist --no-scripts
else
  "$ROOT/scripts/release-identity" prepare
  [[ ! -e "$consumer" ]] || { echo 'Consumer output already exists; choose a fresh qualification output' >&2; exit 1; }
  mkdir -p "$consumer"
  python3 - "$artifacts" <<'PYTHON'
import json, pathlib, sys, zipfile
root=pathlib.Path(sys.argv[1]).resolve()
identity=json.loads((root/'release-identity.json').read_text())
with zipfile.ZipFile(root/'core.zip') as archive:
    package=json.loads(archive.read('core/composer.json'))
package['version']=identity['version']
package['dist']={'type':'zip','url':(root/'core.zip').as_uri(),'reference':identity['sourceCommit']}
package['source']={'type':'git','url':'https://github.com/peanut-business/peanut-admin-core-php.git','reference':identity['sourceCommit']}
consumer={'name':'peanut-admin/ci-consumer','require':{'peanut-admin/core':identity['version']},'repositories':[{'type':'package','package':package}]}
(root/'consumer/composer.json').write_text(json.dumps(consumer, indent=2)+'\n')
PYTHON
  composer --working-dir="$consumer" install --no-interaction --no-progress --prefer-dist --no-scripts
fi

installed="$consumer/vendor/peanut-admin/core"
[[ -d "$installed" && ! -L "$installed" ]] || {
  echo 'verify-consumer: Core package was not installed as an isolated copy' >&2
  exit 1
}
php -r '
require $argv[1];
$classes = array_slice($argv, 2);
foreach ($classes as $class) {
    if (!class_exists($class)) {
        fwrite(STDERR, "missing public class: {$class}\n");
        exit(1);
    }
}
printf("PHP-CORE-CONSUMER-001 passed: %d public package namespaces\n", count($classes));
' "$consumer/vendor/autoload.php" \
  'PeanutAdmin\Kernel\Package' \
  'PeanutAdmin\DataPermission\Package' \
  'PeanutAdmin\FileMedia\Package' \
  'PeanutAdmin\IntegrationSecurity\Webhook\WebhookDestination' \
  'PeanutAdmin\Settings\Secret\SecretStorageContext'

if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
  printf -- '- Clean Composer consumer: passed (5 public namespaces)\n- Candidate: `%s`\n' "$candidate" >>"$GITHUB_STEP_SUMMARY"
fi
if [[ "${1:-}" != --public ]]; then
  "$ROOT/scripts/release-identity" qualify
fi
rm -rf -- "$consumer/vendor"
