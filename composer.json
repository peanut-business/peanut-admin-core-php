{
  "name": "peanut-admin/core",
  "description": "Peanut Admin technical kernel and ThinkPHP integration",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "opis/json-schema": "^2.6.0",
    "php": "^8.3",
    "topthink/think-orm": "^4.0.51"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5.31"
  },
  "suggest": {
    "aliyuncs/oss-sdk-php": "Required by hosts that construct AliyunStorageDriver.",
    "qcloud/cos-sdk-v5": "Required by hosts that construct QcloudStorageDriver.",
    "qiniu/php-sdk": "Required by hosts that construct QiniuStorageDriver."
  },
  "autoload": {
    "psr-4": {
      "PeanutAdmin\\DataPermission\\": "data-permission/src/",
      "PeanutAdmin\\FileMedia\\": "file-media/src/",
      "PeanutAdmin\\IntegrationSecurity\\": "integration-security/src/",
      "PeanutAdmin\\Kernel\\": "kernel/src/",
      "PeanutAdmin\\Settings\\": "settings/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PeanutAdmin\\DataPermission\\Tests\\": "data-permission/tests/",
      "PeanutAdmin\\FileMedia\\Tests\\": "file-media/tests/",
      "PeanutAdmin\\Kernel\\Tests\\": "kernel/tests/",
      "PeanutAdmin\\Settings\\Tests\\": "settings/tests/",
      "PeanutAdmin\\Testing\\": "testing/src/",
      "PeanutAdmin\\Testing\\Tests\\": "testing/tests/"
    }
  }
}
